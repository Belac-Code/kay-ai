# Provider keys (keep .env private)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Model overrides
OPENAI_MODEL=gpt-5-mini
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_IMAGE_MODEL=gpt-image-1
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# MongoDB account and conversation storage (required for sign-up/login)
MONGODB_URI=mongodb://KayAI:KayAI790-xxxxxxx-shard-00-00.xxxxx.mongodb.net:27017,ac-xxxxxxx-shard-00-01.xxxxx.mongodb.net:27017,ac-xxxxxxx-shard-00-02.xxxxx.mongodb.net:27017/kay?ssl=true&replicaSet=atlas-xxxxxx-shard-0&authSource=admin&retryWrites=true&w=majority
JWT_SECRET=
COOKIE_SECURE=false
KAY_PROVIDER_TIMEOUT_MS=90000

# Social sign-in (register these exact callback URLs with each provider)
KAY_BASE_URL=http://127.0.0.1:4173
KAY_CREATOR_EMAIL=printkayleb-account-email@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Persistence: if unset or unreachable, KAY uses ./data/kay-memory.json
DATABASE_URL=
KAY_USER_ID=00000000-0000-4000-8000-000000000001

# Local server settings
PORT=4173
MAX_UPLOAD_MB=20
